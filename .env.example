# ---------------------------------------------------------------------------
# Reference for every environment variable used by the project.
# Copy the relevant block into backend/.env and frontend/.env.local.
# Placeholders only — never commit real secrets.
# ---------------------------------------------------------------------------

# ===== backend/.env ========================================================

NODE_ENV=development
PORT=4000

# Supabase Postgres connection string.
# Project Settings -> Database -> Connection string -> URI.
# Use the pooled (port 6543) connection for serverless runtimes and append
# ?pgbouncer=true&connection_limit=1; use the direct (port 5432) connection
# for a long-lived Node process and for running migrations.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Signing key for session JWTs. Must be at least 32 characters.
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Session cookie. Use SameSite=none (which forces Secure) when the frontend and
# API are served from different registrable domains in production.
COOKIE_NAME=appointment_ai_token
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourdomain.com

# Browser origin(s) allowed to call this API. Comma-separated for multiple.
FRONTEND_URL=http://localhost:3000

# Mistral AI. Server-side only — this key must never reach the browser.
# Create one at https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_TIMEOUT_MS=20000

# bcrypt work factor. 12 is a good balance; raise it as hardware improves.
BCRYPT_ROUNDS=12

LOG_LEVEL=info

# IANA timezone used when a client does not send one.
DEFAULT_TIMEZONE=UTC


# ===== frontend/.env.local =================================================

# Base URL of the Express API. Public by design: it is a URL, not a secret.
NEXT_PUBLIC_API_URL=http://localhost:4000


# ===== backend/.env.test (integration tests) ===============================

# Tests truncate tables between runs — point this at a throwaway database,
# never at the development or production one.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/appointment_ai_test
